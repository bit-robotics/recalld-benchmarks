# Copy this file to amb/.env and fill in your keys.
# (scripts/setup.py does the copy for you.)
# Never commit a file that contains real keys.

# --- AMB (answer + judge LLMs) ---
# AMB's own defaults are a Groq answerer and a Gemini judge. The published runs
# in results/ used Gemini for both, routed through Vertex AI (see below).
GEMINI_API_KEY=

# Published-run configuration. Uncomment all five lines to reproduce results/.
# Left commented, AMB uses its default Groq answerer and the Recalld adapter
# returns facts instead of source excerpts.
# OMB_ANSWER_LLM=gemini
# OMB_ANSWER_MODEL=gemini-3.1-pro-preview
# OMB_JUDGE_LLM=gemini
# OMB_JUDGE_MODEL=gemini-2.5-flash-lite
# RECALLD_ANSWER_CONTEXT=sources

# Optional: route the "gemini" provider through Vertex AI instead of AI Studio.
# Use this when AI Studio's per-tier daily request cap (e.g. 250 RPD for
# gemini-3.1-pro at tier 1) blocks a full benchmark run. Vertex has no such
# cap. Requires a service account with the Vertex AI User role; point
# GOOGLE_APPLICATION_CREDENTIALS at its key file, kept outside this repository.
# GEMINI_BACKEND=vertex
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Recalld (https://recalld.ai) ---
RECALLD_API_KEY=
RECALLD_BASE_URL=https://eu.recalld.ai
RECALLD_EMBEDDING_MODEL=gemini-embedding-002-vertex

# --- Mem0 OSS, self-hosted ---
MEM0_OSS_BASE_URL=http://localhost:8888

# --- Recalld sweep runner (set by scripts/run_recalld_sweep.py; do not enable globally) ---
# RECALLD_TOP_K=25
# RECALLD_AGENT_MAP_PATH=experiments/sweeps/<sweep-id>/recalld-agents.json
# RECALLD_KEEP_BENCHMARK_AGENTS=true
